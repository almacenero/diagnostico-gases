{
  "name": "diagnostico-gases",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PWA que traduce las lecturas del analizador de gases en un diagnóstico detallado del vehículo.",
  "scripts": {
    "build:template": "node scripts/build-template.mjs",
    "licencia": "node scripts/licencia.mjs",
    "release": "npm run build:template && node scripts/release.mjs",
    "vendor": "cp node_modules/xlsx/dist/xlsx.full.min.js vendor/",
    "test": "node --test tests/*.test.js",
    "start": "npx --yes serve -l 5173 ."
  },
  "devDependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
